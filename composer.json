{
  "name": "omegaalfa/cache",
  "description": "Explicit, predictable PSR-6 and PSR-16 cache stores for PHP 8.4.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "psr/cache": "^3.0",
    "psr/simple-cache": "^3.0",
    "psr/clock": "^1.0"
  },
  "require-dev": {
    "cache/integration-tests": "dev-master",
    "friendsofphp/php-cs-fixer": "^3.80",
    "infection/infection": "^0.31",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0"
  },
  "provide": {
    "psr/cache-implementation": "3.0",
    "psr/simple-cache-implementation": "3.0"
  },
  "suggest": {
    "ext-redis": "Required by RedisStore.",
    "ext-apcu": "Required by ApcuStore.",
    "ext-igbinary": "Required by IgbinarySerializer.",
    "ext-msgpack": "Required by MsgpackSerializer."
  },
  "autoload": {
    "psr-4": {
      "Omegaalfa\\Cache\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Omegaalfa\\Cache\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "test:coverage": "phpunit --coverage-text --coverage-clover=build/coverage.xml",
    "analyse": "phpstan analyse",
    "style": "php-cs-fixer fix --dry-run --diff",
    "style:fix": "php-cs-fixer fix",
    "benchmark": "php benchmarks/run.php",
    "mutation": "infection --threads=max",
    "check": [
      "@validate:package",
      "@style",
      "@phpstan",
      "@test"
    ],
    "phpstan": "phpstan analyse",
    "validate:package": [
      "composer validate --strict",
      "composer dump-autoload --optimize --strict-psr"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
